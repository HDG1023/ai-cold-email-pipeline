# AI Cold Email Pipeline — API Keys
# Copy this file to .env and fill in your actual keys.
# Never commit .env to version control.

# Apollo.io API Key
# Get it from: apollo.io → Admin Settings → Integrations → API Keys
APOLLO_API_KEY=your_apollo_api_key_here

# Cold Email Sequencer API Key
# Saleshandy: Settings → API Key
# Smartlead:   Settings → API
# Instantly:   Settings → API
SEQUENCER_API_KEY=your_sequencer_api_key_here
SEQUENCER_TOOL=saleshandy   # options: saleshandy | smartlead | instantly

# Maildoso API Key (optional — for infrastructure management)
# Get it from: maildoso.com → Settings → API
MAILDOSO_API_KEY=your_maildoso_api_key_here
